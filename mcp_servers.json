{
  "mcpServers": {
    "fastapi": {
      "url": "http://localhost:8003/mcp"
    },
    "filesystem": {
      "command": "bun",
      "args": ["x", "@modelcontextprotocol/server-filesystem", "./"]
    },
    "bash": {
      "command": "bun",
      "args": ["x", "bash-mcp"]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "./"]
    }
  }
}
