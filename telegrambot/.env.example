# --- Telegram (REQUIRED) ---
TELEGRAM_BOT_TOKEN=

# Comma-separated allowlist of chat_ids. Empty = allow all.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- LLM provider (REQUIRED: minimax | gemini | ollama) ---
LLM_PROVIDER=minimax

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3:cloud

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=minimax-m3:cloud

# Qwencloud
DASHSCOPE_API_KEY=sk-xxxx-your-dashscope-api-key
QWENCLOUD_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWENCLOUD_MODEL=qwen-max

# --- LLM behavior ---
MAX_INPUT_CHARS=4000
MAX_CONTEXT_TURNS=10
REQUEST_TIMEOUT_SEC=60

# --- Rate limit ---
OUTBOUND_SEMAPHORE=30
PER_USER_MSG_PER_MINUTE=20

# --- Media upload limits ---
MAX_IMAGE_FILE_SIZE_MB=10       # Max image upload size (MB)
MAX_IMAGE_DIMENSION=2048        # Max image width/height before auto-resize (px)
MAX_PDF_FILE_SIZE_MB=20         # Max PDF upload size (MB)

# --- Logging ---
LOG_LEVEL=INFO
