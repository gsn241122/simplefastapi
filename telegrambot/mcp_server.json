{
  "local_skills": {
    "path": "skills",
    "timeout_sec": 30
  },
  "mcpServers": {
    "sequential-thinking": {
      "command": "bun",
      "args": [
        "x",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "fastapi": {
      "command": "/home/dell/Desktop/workspace/simplefastapi/.venv/bin/python",
      "args": ["/home/dell/Desktop/workspace/simplefastapi/mcp_wrapper/server.py"],
      "env": {}
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./"]
    },
    "bash": {
      "command": "bun",
      "args": ["x", "bash-mcp"]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "../"]
    },
    "fetch": {
      "command": "uv",
      "args": ["run", "mcp-server-fetch"],
      "env": {}
    },
    "time": {
      "command": "uv",
      "args": ["run", "mcp-server-time"],
      "env": {}
    },
    "tmux": {
      "command": "bun",
      "args": ["x", "tmux-mcp"],
      "env": {}
    },
    "ollama": {
      "command": "bun",
      "args": ["x", "ollama-mcp"],
      "env": {}
    },
    "adb": {
      "command": "bun",
      "args": ["x", "adb-mcp"],
      "env": {}
    },
    "playwright": {
      "command": "bun",
      "args": ["x", "@playwright/mcp@latest"],
      "env": {}
    },
    "app-manager": {
      "command": "/home/dell/Desktop/workspace/appmanager/.venv/bin/python",
      "args": ["/home/dell/Desktop/workspace/appmanager/app_manager_mcp.py"]
    },
    "code_db_chroma": {
      "command": "/home/dell/Desktop/workspace/simplefastapi/.venv/bin/chroma-mcp",
      "args": [
          "--client-type", "persistent",
          "--data-dir", "/home/dell/Desktop/workspace/simplefastapi/telegrambot/code_db"
      ],
      "env": {
          "PATH": "/home/dell/Desktop/workspace/simplefastapi/.venv/bin:/usr/bin:/bin"
      }
    }
  }
}