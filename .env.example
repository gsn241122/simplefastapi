# Application Settings
APP_NAME="SimpleFastAPI App"
APP_VERSION="1.0.0"
DEBUG=False

# Database Settings
# SQLite (for development/smoke test)
DATABASE_URL="sqlite:///./app.db"

# PostgreSQL (for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# MySQL (for production)
# DATABASE_URL="mysql+pymysql://user:password@localhost:3306/dbname"

# Security Settings
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Key for demo purposes
# Change this in production
API_KEY="demo-api-key-12345"

# Email Settings (for email notifications)
MAIL_SERVER="localhost"
MAIL_PORT=587
MAIL_USERNAME=""  # e.g., user@gmail.com
MAIL_PASSWORD=""  # app password or real password
MAIL_FROM="noreply@fastapi.app"
MAIL_FROM_NAME="FastAPI App"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_VALIDATE_CERTS=True
MAIL_USE_CREDENTIALS=True

# File Upload Settings
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE=10485760  # 10 MB in bytes
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/gif,image/webp"  # Comma-separated list